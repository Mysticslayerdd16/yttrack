{
  "manifest_version": 3,
  "name": "YTTrack — YouTube Music Tracker",
  "version": "1.0.0",
  "description": "Automatically tracks YouTube songs you play and saves them to your YTTrack dashboard.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
